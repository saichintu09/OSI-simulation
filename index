<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OSI Model Step-by-Step Data Journey & Encapsulation</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .layer-box { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between selection:bg-blue-500 selection:text-white">

    <!-- Top Navigation / Controls Header -->
    <header class="w-full bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-6 py-4 sticky top-0 z-50 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/30">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            </div>
            <div>
                <h1 class="text-lg font-extrabold bg-gradient-to-r from-blue-400 via-indigo-300 to-cyan-300 bg-clip-text text-transparent">OSI Model Step-by-Step Travel</h1>
                <p class="text-xs text-slate-400">Client Encapsulation (7→1) ➔ Network Transit ➔ Server Decapsulation (1→7)</p>
            </div>
        </div>

        <!-- Interactive Control Bar -->
        <div class="flex items-center space-x-2 bg-slate-800/90 p-1.5 rounded-xl border border-slate-700/80 shadow-inner">
            <button onclick="resetSim()" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700 hover:bg-slate-600 text-slate-200 transition flex items-center space-x-1 shadow">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                <span>Reset</span>
            </button>
            <button onclick="prevStep()" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700 hover:bg-slate-600 text-slate-200 transition flex items-center space-x-1 shadow">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                <span>Prev</span>
            </button>
            <button id="playBtn" onclick="togglePlay()" class="px-4 py-1.5 rounded-lg text-xs font-bold bg-blue-600 hover:bg-blue-500 text-white shadow-md shadow-blue-600/40 transition flex items-center space-x-1">
                <svg id="playIcon" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <span id="playLabel">Auto Play</span>
            </button>
            <button onclick="nextStep()" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-700 hover:bg-blue-600 text-white transition flex items-center space-x-1 shadow">
                <span>Next</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </button>
        </div>
    </header>

    <!-- Main Workspace Container housing the Scalable SVG -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 flex flex-col justify-center items-center">
        <div class="w-full bg-slate-900/60 border border-slate-800 rounded-2xl p-4 shadow-2xl relative overflow-hidden backdrop-blur-sm">
            
            <!-- Embedded SVG Graphic (Fully Responsive & Self-Contained) -->
            <svg viewBox="0 0 1200  680" class="w-full h-auto max-h-[620px]" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="blueCardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#1e293b" />
                        <stop offset="100%" stop-color="#0f172a" />
                    </linearGradient>
                    <linearGradient id="activeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#2563eb" />
                        <stop offset="100%" stop-color="#1d4ed8" />
                    </linearGradient>
                    <linearGradient id="transitGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#3b82f6" />
                        <stop offset="50%" stop-color="#6366f1" />
                        <stop offset="100%" stop-color="#06b6d4" />
                    </linearGradient>
                    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                        <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#3b82f6" flood-opacity="0.4"/>
                    </filter>
                </defs>

                <!-- Background Panel Layout -->
                <rect width="1200" height="680" rx="16" fill="#090d16" stroke="#1e293b" stroke-width="2"/>

                <!-- SECTION 1: SENDER (ENCAPSULATION 7 -> 1) -->
                <g id="senderSection" transform="translate(40, 40)">
                    <rect x="0" y="0" width="340" height="520" rx="12" fill="#0f172a" stroke="#1e3a8a" stroke-width="2"/>
                    <rect x="0" y="0" width="340" height="44" rx="12" fill="#1e3a8a"/>
                    <text x="20" y="27" fill="#93c5fd" font-size="14" font-weight="700">Client Device (Encapsulation 7 ➔ 1)</text>

                    <!-- Layers 7 to 1 Stacks -->
                    <!-- L7 -->
                    <g id="svg-s-7" class="layer-box" transform="translate(15, 60)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-s-7"/>
                        <circle cx="28" cy="26" r="14" fill="#2563eb"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">7</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Application Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">PDU: Data (HTTP, DNS)</text>
                    </g>
                    <!-- L6 -->
                    <g id="svg-s-6" class="layer-box" transform="translate(15, 120)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-s-6"/>
                        <circle cx="28" cy="26" r="14" fill="#2563eb"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">6</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Presentation Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">PDU: Data (SSL / Encryption)</text>
                    </g>
                    <!-- L5 -->
                    <g id="svg-s-5" class="layer-box" transform="translate(15, 180)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-s-5"/>
                        <circle cx="28" cy="26" r="14" fill="#2563eb"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">5</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Session Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">PDU: Data + Session Tokens</text>
                    </g>
                    <!-- L4 -->
                    <g id="svg-s-4" class="layer-box" transform="translate(15, 240)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-s-4"/>
                        <circle cx="28" cy="26" r="14" fill="#2563eb"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">4</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Transport Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">PDU: Segment (TCP/UDP Ports)</text>
                    </g>
                    <!-- L3 -->
                    <g id="svg-s-3" class="layer-box" transform="translate(15, 300)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-s-3"/>
                        <circle cx="28" cy="26" r="14" fill="#2563eb"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">3</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Network Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">PDU: Packet (IP Addressing)</text>
                    </g>
                    <!-- L2 -->
                    <g id="svg-s-2" class="layer-box" transform="translate(15, 360)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-s-2"/>
                        <circle cx="28" cy="26" r="14" fill="#2563eb"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">2</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Data Link Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">PDU: Frame (MAC Addresses)</text>
                    </g>
                    <!-- L1 -->
                    <g id="svg-s-1" class="layer-box" transform="translate(15, 420)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-s-1"/>
                        <circle cx="28" cy="26" r="14" fill="#2563eb"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">1</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Physical Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">PDU: Bits (Electrical / Optical)</text>
                    </g>
                </g>

                <!-- SECTION 2: NETWORK TRANSIT CHANNEL -->
                <g id="transitSection" transform="translate(405, 40)">
                    <rect x="0" y="0" width="390" height="520" rx="12" fill="#0b1329" stroke="#1e293b" stroke-width="2"/>
                    <rect x="0" y="0" width="390" height="44" rx="12" fill="#0f172a" stroke="#1e293b"/>
                    <text x="195" y="27" fill="#38bdf8" font-size="14" font-weight="700" text-anchor="middle">Network Transmission Medium</text>

                    <!-- Transmission Pathway Graphic -->
                    <line x1="40" y1="260" x2="350" y2="260" stroke="url(#transitGrad)" stroke-width="6" stroke-dasharray="10 6" stroke-linecap="round"/>
                    
                    <!-- Animated Packet in Flight -->
                    <g id="flightPacket" transform="translate(195, 230)" filter="url(#glow)">
                        <rect x="-80" y="-30" width="160" height="60" rx="10" fill="#0f172a" stroke="#38bdf8" stroke-width="2"/>
                        <text x="0" y="-8" fill="#38bdf8" font-size="11" font-weight="700" text-anchor="middle" id="transitUnitText">PDU: BITS / PACKET</text>
                        <text x="0" y="12" fill="#cbd5e1" font-size="10" text-anchor="middle" id="transitSubText">In Flight Across Router Network</text>
                    </g>

                    <!-- Status Badge -->
                    <rect x="75" y="420" width="240" height="50" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1"/>
                    <text x="195" y="442" fill="#93c5fd" font-size="11" font-weight="700" text-anchor="middle" id="stepBadgeTitle">STEP 1 OF 14</text>
                    <text x="195" y="458" fill="#f8fafc" font-size="12" text-anchor="middle" id="stepBadgeSub">Application Layer Encapsulation</text>
                </g>

                <!-- SECTION 3: SERVER (DECAPSULATION 1 -> 7) -->
                <g id="serverSection" transform="translate(820, 40)">
                    <rect x="0" y="0" width="340" height="520" rx="12" fill="#0f172a" stroke="#312e81" stroke-width="2"/>
                    <rect x="0" y="0" width="340" height="44" rx="12" fill="#312e81"/>
                    <text x="20" y="27" fill="#c7d2fe" font-size="14" font-weight="700">Server Device (Decapsulation 1 ➔ 7)</text>

                    <!-- Layers 1 to 7 Stacks -->
                    <!-- L1 Server -->
                    <g id="svg-r-1" class="layer-box" transform="translate(15, 60)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-r-1"/>
                        <circle cx="28" cy="26" r="14" fill="#4f46e5"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">1</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Physical Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">Receiving Raw Bitstream</text>
                    </g>
                    <!-- L2 Server -->
                    <g id="svg-r-2" class="layer-box" transform="translate(15, 120)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-r-2"/>
                        <circle cx="28" cy="26" r="14" fill="#4f46e5"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">2</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Data Link Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">Unwrapping MAC Frame</text>
                    </g>
                    <!-- L3 Server -->
                    <g id="svg-r-3" class="layer-box" transform="translate(15, 180)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-r-3"/>
                        <circle cx="28" cy="26" r="14" fill="#4f46e5"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">3</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Network Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">Unwrapping IP Packet</text>
                    </g>
                    <!-- L4 Server -->
                    <g id="svg-r-4" class="layer-box" transform="translate(15, 240)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-r-4"/>
                        <circle cx="28" cy="26" r="14" fill="#4f46e5"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">4</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Transport Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">Unwrapping TCP/UDP Segment</text>
                    </g>
                    <!-- L5 Server -->
                    <g id="svg-r-5" class="layer-box" transform="translate(15, 300)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-r-5"/>
                        <circle cx="28" cy="26" r="14" fill="#4f46e5"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">5</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Session Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">Re-establishing Session</text>
                    </g>
                    <!-- L6 Server -->
                    <g id="svg-r-6" class="layer-box" transform="translate(15, 360)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-r-6"/>
                        <circle cx="28" cy="26" r="14" fill="#4f46e5"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">6</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Presentation Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">Decrypting & Formatting Data</text>
                    </g>
                    <!-- L7 Server -->
                    <g id="svg-r-7" class="layer-box" transform="translate(15, 420)">
                        <rect width="310" height="52" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1.5" id="box-r-7"/>
                        <circle cx="28" cy="26" r="14" fill="#4f46e5"/><text x="28" y="31" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">7</text>
                        <text x="56" y="24" fill="#f8fafc" font-size="13" font-weight="700">Application Layer</text>
                        <text x="56" y="40" fill="#94a3b8" font-size="10">Delivering Final User Data</text>
                    </g>
                </g>

            </svg>

        </div>
    </main>

    <!-- Bottom Explanation Footer -->
    <footer class="w-full bg-slate-900 border-t border-slate-800 p-4 sm:px-8">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
            
            <div class="md:col-span-2 flex flex-col space-y-1">
                <div class="flex items-center space-x-2">
                    <span id="footerLayerBadge" class="text-xs px-2.5 py-0.5 rounded bg-blue-600 text-white font-bold">Layer 7</span>
                    <h3 id="footerLayerTitle" class="text-sm font-bold text-white">Application Layer (Sender)</h3>
                </div>
                <p id="footerDesc" class="text-xs text-slate-300 leading-relaxed">
                    User interacts with network services (HTTP, DNS). Data is created and prepared for network transport.
                </p>
            </div>

            <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 flex flex-col justify-center">
                <div class="text-[10px] uppercase font-bold text-slate-400 mb-1">Protocol Data Unit (PDU)</div>
                <div id="footerPdu" class="text-xs font-mono text-cyan-400 font-semibold truncate">Data (Raw User Payload)</div>
                <div class="text-[10px] text-slate-400 mt-1 flex justify-between">
                    <span>Security Control: <strong id="footerSec" class="text-slate-200">WAF / App Filter</strong></span>
                </div>
            </div>

        </div>
    </footer>

    <script>
        // Full OSI Layer specifications for step-by-step narration
        const stepsData = [
            // SENDER ENCAPSULATION (Steps 0 to 6)
            { type: 'sender', layer: 7, title: 'Application Layer Encapsulation', pdu: 'Data', desc: 'User requests information via web/mail apps (HTTP, FTP, DNS). The raw data payload is created.', sec: 'WAF / Web Filtering', transitText: 'Data Payload ready', subText: 'Layer 7 (Sender)' },
            { type: 'sender', layer: 6, title: 'Presentation Layer Encapsulation', pdu: 'Data (Encrypted)', desc: 'Data is formatted, compressed, and encrypted (SSL/TLS) ensuring secure and readable syntax across different systems.', sec: 'Encryption & Compression', transitText: 'Formatted & Encrypted Data', subText: 'Layer 6 (Sender)' },
            { type: 'sender', layer: 5, title: 'Session Layer Encapsulation', pdu: 'Data + Session Header', desc: 'Establishes, maintains, and terminates communication sessions between applications on distinct network devices.', sec: 'Session Tokens & Auth', transitText: 'Session-Wrapped Data', subText: 'Layer 5 (Sender)' },
            { type: 'sender', layer: 4, title: 'Transport Layer Encapsulation', pdu: 'Segment / Datagram', desc: 'Breaks data into segments, adds TCP/UDP headers, port numbers, and ensures reliable error-checked delivery.', sec: 'Firewalls & Port Filtering', transitText: 'TCP / UDP Segment', subText: 'Layer 4 (Sender)' },
            { type: 'sender', layer: 3, title: 'Network Layer Encapsulation', pdu: 'Packet', desc: 'Wraps segments with IP headers containing source and destination IP addresses for router path selection.', sec: 'Access Control Lists (ACL)', transitText: 'IP Packet', subText: 'Layer 3 (Sender)' },
            { type: 'sender', layer: 2, title: 'Data Link Layer Encapsulation', pdu: 'Frame', desc: 'Encapsulates packets into frames with physical MAC source/destination addresses and trailer checksums for local media access.', sec: 'Network Segmentation', transitText: 'MAC Frame', subText: 'Layer 2 (Sender)' },
            { type: 'sender', layer: 1, title: 'Physical Layer Encapsulation', pdu: 'Bits (0s & 1s)', desc: 'Converts frames into raw electrical signals, optical pulses, or radio waves for physical transmission across cables/Wi-Fi.', sec: 'Physical Security', transitText: 'Electrical / Optical Bits', subText: 'Layer 1 (Sender)' },

            // TRANSIT (Step 7)
            { type: 'transit', layer: 0, title: 'Network Transit across Routers & Switches', pdu: 'Bits in Flight', desc: 'The complete bitstream travels across physical network hardware (routers, switches, fiber cables) towards the destination server.', sec: 'Router Inspection', transitText: 'Packet in Transit ➔', subText: 'Physical Medium' },

            // SERVER DECAPSULATION (Steps 8 to 14)
            { type: 'receiver', layer: 1, title: 'Physical Layer Decapsulation', pdu: 'Bits Received', desc: 'The destination server NIC receives raw physical signals and reconstructs them into digital bitstreams.', sec: 'NIC Hardware Filter', transitText: 'Reconstructing Bits', subText: 'Layer 1 (Server)' },
            { type: 'receiver', layer: 2, title: 'Data Link Layer Decapsulation', pdu: 'Frame Unwrapped', desc: 'Server checks MAC addresses and frame checksums, strips the Layer 2 header, and extracts the inner packet.', sec: 'Port Security', transitText: 'Unwrapping Frame', subText: 'Layer 2 (Server)' },
            { type: 'receiver', layer: 3, title: 'Network Layer Decapsulation', pdu: 'Packet Unwrapped', desc: 'Server verifies IP headers, strips the Layer 3 header, and forwards the data segment to transport protocols.', sec: 'Firewall IP Check', transitText: 'Unwrapping IP Packet', subText: 'Layer 3 (Server)' },
            { type: 'receiver', layer: 4, title: 'Transport Layer Decapsulation', pdu: 'Segment Unwrapped', desc: 'TCP/UDP headers are inspected, reassembling ordered segments and checking for transmission errors.', sec: 'Port Inspection', transitText: 'Assembling Segment', subText: 'Layer 4 (Server)' },
            { type: 'receiver', layer: 5, title: 'Session Layer Decapsulation', pdu: 'Session Handshake', desc: 'Session tokens and dialog parameters are processed, concluding the active connection conversation.', sec: 'Session Manager', transitText: 'Processing Session', subText: 'Layer 5 (Server)' },
            { type: 'receiver', layer: 6, title: 'Presentation Layer Decapsulation', pdu: 'Data Decrypted', desc: 'Data is decrypted, decompressed, and translated into plain application-understandable formatting.', sec: 'SSL Termination', transitText: 'Decrypting Payload', subText: 'Layer 6 (Server)' },
            { type: 'receiver', layer: 7, title: 'Application Layer Delivery', pdu: 'Final User Data', desc: 'The application receives the final clean payload data, successfully completing client-to-server communication!', sec: 'Server App Service', transitText: 'Data Delivered!', subText: 'Layer 7 (Server)' }
        ];

        let currentStepIndex = 0;
        let isPlaying = false;
        let playTimer = null;

        function updateDisplay() {
            const step = stepsData[currentStepIndex];

            // Reset all SVG layer rect styles
            for(let i=1; i<=7; i++) {
                const sBox = document.getElementById(`box-s-${i}`);
                const rBox = document.getElementById(`box-r-${i}`);
                sBox.setAttribute('fill', '#1e293b');
                sBox.setAttribute('stroke', '#334155');
                sBox.setAttribute('stroke-width', '1.5');

                rBox.setAttribute('fill', '#1e293b');
                rBox.setAttribute('stroke', '#334155');
                rBox.setAttribute('stroke-width', '1.5');
            }

            // Highlight active layer box
            if (step.type === 'sender') {
                const activeBox = document.getElementById(`box-s-${step.layer}`);
                activeBox.setAttribute('fill', '#1d4ed8');
                activeBox.setAttribute('stroke', '#60a5fa');
                activeBox.setAttribute('stroke-width', '2.5');
            } else if (step.type === 'receiver') {
                const activeBox = document.getElementById(`box-r-${step.layer}`);
                activeBox.setAttribute('fill', '#4338ca');
                activeBox.setAttribute('stroke', '#818cf8');
                activeBox.setAttribute('stroke-width', '2.5');
            }

            // Update transit badge & text
            document.getElementById('transitUnitText').textContent = step.pdu;
            document.getElementById(' transitSubText').textContent = step.subText;
            document.getElementById('stepBadgeTitle').textContent = `STEP ${currentStepIndex + 1} OF ${stepsData.length}`;
            document.getElementById('stepBadgeSub').textContent = step.title;

            // Update Footer Details
            document.getElementById('footerLayerBadge').textContent = step.layer > 0 ? `Layer ${step.layer}` : 'Network Transit';
            document.getElementById('footerLayerTitle').textContent = step.title;
            document.getElementById('footerDesc').textContent = step.desc;
            document.getElementById('footerPdu').textContent = step.pdu;
            document.getElementById('footerSec').textContent = step.sec;
        }

        function nextStep() {
            currentStepIndex = (currentStepIndex + 1) % stepsData.length;
            updateDisplay();
        }

        function prevStep() {
            currentStepIndex = (currentStepIndex - 1 + stepsData.length) % stepsData.length;
            updateDisplay();
        }

        function resetSim() {
            currentStepIndex = 0;
            if (isPlaying) togglePlay();
            updateDisplay();
        }

        function togglePlay() {
            isPlaying = !isPlaying;
            const btn = document.getElementById('playBtn');
            const label = document.getElementById('playLabel');
            const icon = document.getElementById('playIcon');

            if (isPlaying) {
                label.textContent = 'Pause';
                icon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
                btn.className = "px-4 py-1.5 rounded-lg text-xs font-bold bg-amber-600 hover:bg-amber-500 text-white shadow-md shadow-amber-600/40 transition flex items-center space-x-1";
                playTimer = setInterval(() => {
                    currentStepIndex = (currentStepIndex + 1) % stepsData.length;
                    updateDisplay();
                }, 2200);
            } else {
                label.textContent = 'Auto Play';
                icon.innerHTML = '<path d="M8 5v14l11-7z"/>';
                btn.className = "px-4 py-1.5 rounded-lg text-xs font-bold bg-blue-600 hover:bg-blue-500 text-white shadow-md shadow-blue-600/40 transition flex items-center space-x-1";
                clearInterval(playTimer);
            }
        }

        window.onload = function() {
            updateDisplay();
        };
    </script>
</body>
</html>
